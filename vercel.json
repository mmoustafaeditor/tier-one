{
  "functions": {
    "api/data/*.js": {
      "includeFiles": "data/seed/**"
    },
    "api/tier-one/v3/index.js": {
      "includeFiles": "data/seed/**"
    },
    "api/tier-one/v4/index.js": {
      "includeFiles": "{data/seed/**,api/tier-one/v4/config/*.json}"
    },
    "api/tier-one/v4/stripe-webhook.js": {
      "includeFiles": "{data/seed/**,api/tier-one/v4/config/*.json}"
    }
  },
  "rewrites": [
    {
      "source": "/the-gaffer",
      "destination": "/the-gaffer/index.html"
    }
  ],
  "headers": [
    {
      "source": "/tier-one/(index.html|version.json|sw.js|manifest.webmanifest)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/tier-one/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/tier-one/"
        }
      ]
    },
    {
      "source": "/tier-one/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tier-one/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=604800"
        }
      ]
    },
    {
      "source": "/tier-one/films/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, s-maxage=2592000, stale-while-revalidate=86400"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/tier-one/apk/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/the-gaffer/(index.html|version.json)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/the-gaffer",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/TheGaffer.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"TheGaffer.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/data/seed/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tier-one-v3",
      "destination": "/tier-one/",
      "permanent": false
    },
    {
      "source": "/tier-one-v3/:path*",
      "destination": "/tier-one/",
      "permanent": false
    }
  ]
}
