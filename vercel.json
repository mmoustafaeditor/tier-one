{
  "functions": {
    "api/data/*.js": {
      "includeFiles": "data/seed/**"
    },
    "api/tier-one/v3/index.js": {
      "includeFiles": "data/seed/**"
    }
  },
  "rewrites": [
    {
      "source": "/the-gaffer",
      "destination": "/the-gaffer/index.html"
    },
    {
      "source": "/tier-one-v3",
      "destination": "/tier-one-v3/index.html"
    }
  ],
  "headers": [
    {
      "source": "/tier-one-v3/(index.html|version.json)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/the-gaffer/(index.html|version.json)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/the-gaffer",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/TheGaffer.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"TheGaffer.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/data/seed/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        }
      ]
    }
  ]
}
