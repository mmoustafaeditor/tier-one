{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true, "lib": ["DOM", "ES2022"],
    "baseUrl": ".", "paths": { "react": ["node_modules/@types/react"], "react/*": ["node_modules/@types/react/*"], "*": ["node_modules/*", "node_modules/@types/*"] }
  },
  "include": ["src", "remotion.config.ts"]
}
