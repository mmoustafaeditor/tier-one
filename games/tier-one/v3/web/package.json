{
  "name": "tier-one-v3",
  "private": true,
  "version": "3.9.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:min": "node scripts/build-world.mjs && tsc --noEmit && vite build --mode min",
    "build:web": "node scripts/build-world.mjs && tsc --noEmit && tsc -p tsconfig.sw.json && vite build --mode web",
    "build:all": "npm run build:min && npm run build:web",
    "serve": "node scripts/dev-server.mjs",
    "smoke:api": "node scripts/api-smoke.mjs",
    "test:live": "node --test scripts/live.test.mjs",
    "test:social": "node --test scripts/social-api.test.mjs",
    "test:onecareer": "node scripts/test-onecareer.mjs",
    "world": "node scripts/build-world.mjs",
    "icons": "node scripts/make-icons.mjs",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "terser": "^5.51.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
