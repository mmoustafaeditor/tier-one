{
  "name": "tier-one-v3",
  "private": true,
  "version": "3.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:min": "node scripts/build-world.mjs && tsc --noEmit && vite build --mode min",
    "serve": "node scripts/dev-server.mjs",
    "smoke:api": "node scripts/api-smoke.mjs",
    "world": "node scripts/build-world.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "terser": "^5.51.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
